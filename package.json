{
    "name": "@r47onfire/jeb",
    "private": true,
    "version": "0.1.0",
    "description": "simple JSON evaluation virtual machine with first-class continuations",
    "exports": {
        ".": {
            "import": "./src/index.ts"
        },
        "./test": {
            "import": "./src/indextest.ts"
        },
        "./doc": {
            "import": "./src/doc.ts"
        }
    },
    "type": "module",
    "scripts": {
        "build": "rm -rf dist/ && bun run regenerate-errno && bun run scripts/build.ts",
        "test": "BUN_JSC_useTailCalls=0 bun test",
        "test:watch": "BUN_JSC_useTailCalls=0 bun test --watch",
        "clean-dist": "rm -rf dist/*",
        "prepare": "bun run build --minify",
        "regenerate-errno": "python3 scripts/regenerate_errno.py >src/errno.ts"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/r47onfire/jeb.git"
    },
    "keywords": [],
    "author": "dragoncoder047",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@babel/parser": "^8.0.10",
        "@babel/traverse": "^8.0.10",
        "@babel/types": "^8.0.10",
        "@types/bun": "^1.4.4",
        "nodemon": "^3.1.14"
    },
    "dependencies": {
        "@r47onfire/game-math": "github:r47onfire/game-math",
        "lib0": "^0.2.119",
        "ts-res": "github:r47onfire/ts-res"
    }
}